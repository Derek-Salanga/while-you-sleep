{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    }
  },
  // *.test.ts are standalone scripts run directly with `node` (see
  // src/lib/date.test.ts), never bundled into the app. They import with
  // an explicit .ts extension because Node's ESM resolver requires it,
  // which this tsconfig would otherwise reject.
  "exclude": ["**/*.test.ts"]
}
